# KEO AI - Environment Variables
# NO SECRETS OR KEYS ARE REQUIRED IN THIS FILE OR IN CI/SECRETS!
# KEO AI uses a complete Bring Your Own Key (BYOK) architecture:
# Every user enters and validates their own personal Google Gemini API key
# directly inside the app under Settings -> "Gemini API Key".
# The key is stored strictly on the user's device and never exposed.

# OPTIONAL: Supabase configuration (only if syncing to an external cloud database)
# If omitted, KEO AI automatically operates 100% offline-first using device storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
